# Banco de dados (Supabase ou Railway PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/flyfree
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=sua_senha_aqui

# GeckoAPI — obtenha em https://dashboard.geckoapi.com.br
GECKOAPI_BASE_URL=https://api.geckoapi.com.br
GECKOAPI_API_KEY=sua_chave_aqui

# Porta do servidor (opcional, padrão 8080)
PORT=8080
